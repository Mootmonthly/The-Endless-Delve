# Normalise all text files to LF in the repository.
* text=auto eol=lf

# Godot text formats
*.gd       text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.cfg      text eol=lf
*.json     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf

# Binary assets
*.png      binary
*.jpg      binary
*.jpeg     binary
*.webp     binary
*.svg      text eol=lf
*.ogg      binary
*.wav      binary
*.mp3      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.res      binary
*.scn      binary
*.zip      binary
